# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres connection string. Supabase: Project Settings > Database >
# Connection string > URI (the pooler on port 6543 is fine).
SUPABASE_DATABASE_URL=postgresql://user:password@host:6543/postgres

# Browser origins allowed to call this API, comma-separated. Needed in
# production because the frontend is deployed separately from the API.
# CORS_ORIGINS=https://your-app.vercel.app

# Optional tuning.
# DB_POOL_MAX=8
# DB_CHECKOUT_TIMEOUT=20

# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Write this file with an editor, not with PowerShell `>>` or `Out-File`:
# those write UTF-16, which looks correct in an editor and parses nowhere.
# `python preflight.py` checks for exactly that.

# --- required ---------------------------------------------------------------

# Postgres connection string.
# Supabase: Project Settings > Database > Connection string > URI.
# The transaction pooler (port 6543) is fine, and needs the
# postgres.<project-ref> username rather than plain "postgres".
#
# If the password contains @ : / # or ? it must be percent-encoded
# (@ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F), otherwise those
# characters are read as URI delimiters and the connection fails looking
# exactly like a wrong password.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- only when the frontend is on a different origin -------------------------

# In the default deployment the React app and this API share one origin
# (the app at /, the API at /api), so neither of these is needed.
#
# Set both only if you split them across hosts:
#   CORS_ORIGINS  here, so the browser is allowed to call the API
#   VITE_API_BASE in the frontend build, so it knows where the API is
# CORS_ORIGINS=https://your-app.vercel.app

# --- optional tuning ---------------------------------------------------------

# Connections held per process. Keep below the database's own limit.
# DB_POOL_MAX=8
# How long a request waits for a free connection before giving up (seconds).
# DB_CHECKOUT_TIMEOUT=20
# A pooled connection idle longer than this is health-checked before reuse.
# DB_IDLE_PROBE_AFTER=20

# Secrets — never commit
.env
.env.*
!.env.example

# The old SQLite database. The app uses Postgres now, and this file also
# contained password hashes and live session tokens.
sahay.db
*.db-journal

# Build artifacts
sahay-sih-submission.zip
frontend/dist/
node_modules/
dist/

# static/ is NOT ignored: build.sh used to overwrite it with the React build,
# but that script is gone and static/index.html is a hand-written source file.

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Playwright MCP browser artifacts (snapshots, screenshots, console logs)
.playwright-mcp/

# NOTE: demo_data/, model.joblib and model_report.json are deliberately
# committed even though run_all.sh regenerates them. The Dockerfile does
# `COPY . .`, so the deployed container needs demo_data/ for POST
# /api/demo/reset and model.joblib for anything above Rules Mode. Ignoring
# them silently downgrades the deployed app.

# Playwright MCP screenshots and snapshots
.playwright-mcp/
*.png
!frontend/public/*.png
